# Copie para .env e ajuste: cp .env.example .env
# O docker compose lê o arquivo .env automaticamente.

# --- Segredos (OBRIGATÓRIO trocar fora do ambiente de aula) ---
# Gere valores com: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
MYFILES_SECRET_KEY=troque-esta-chave-do-backend-por-uma-longa-e-aleatoria
MY_SECRET_KEY=troque-esta-chave-do-frontend-por-uma-longa-e-aleatoria

# --- Usuário inicial (opcional; criado só se ainda não existir) ---
MYFILES_ADMIN_USERNAME=armando
MYFILES_ADMIN_PASSWORD=armando123
MYFILES_ADMIN_EMAIL=armando@ufpi.edu.br

# --- Portas no computador hospedeiro ---
FRONT_PORT=5001
# Swagger do backend em http://localhost:8000/docs (acessível só pela própria máquina)
BACK_PORT=8000

# --- Limites ---
MYFILES_MAX_UPLOAD_MB=50
MYFILES_TOKEN_EXPIRE_MINUTES=30
GUNICORN_WORKERS=2
